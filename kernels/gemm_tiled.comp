// RTorch 通用 tiled GEMM (方案B) — C[r,c] = Σ_k A[r,k]·B[k,c], 尺寸 M/N/K 经 params。
// 16×16 workgroup + shared-mem tiling, 越界填充 0 (通用 M/N/K, 非 1024³ 专用)。
// binding 0=A(m×k), 1=B(k×n), 2=P(M,N,K), 3=C(m×n)
#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };
layout(set = 0, binding = 1) readonly buffer B { float b[]; };
layout(set = 0, binding = 2) readonly buffer P { uint p[]; };
layout(set = 0, binding = 3) writeonly buffer C { float c[]; };
shared float As[16][16];
shared float Bs[16][16];
void main() {
    uint M = p[0]; uint N = p[1]; uint K = p[2];
    uint gx = gl_WorkGroupID.x;   // col tile
    uint gy = gl_WorkGroupID.y;   // row tile
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint row = gy * 16u + ly;
    uint col = gx * 16u + lx;
    float acc = 0.0;
    uint ntiles = (K + 15u) / 16u;
    for (uint t = 0u; t < ntiles; ++t) {
        uint kk = t * 16u + lx;
        uint kb = t * 16u + ly;
        As[ly][lx] = (row < M && kk < K) ? a[row * K + kk] : 0.0;
        Bs[ly][lx] = (kb < K && col < N) ? b[kb * N + col] : 0.0;
        barrier();
        for (uint kj = 0u; kj < 16u; ++kj) acc += As[ly][kj] * Bs[kj][lx];
        barrier();
    }
    if (row < M && col < N) { c[row * N + col] = acc; }
}
