// RTorch GPU tanh-grad. dA[i] = dC[i] * (1 - a[i]^2), where a[i] = tanh(x) (precomputed).
// binding 0=dC(n), 1=a(n), 2=P(N), 3=dA(n)
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) readonly buffer DC { float dc[]; };
layout(set = 0, binding = 1) readonly buffer A { float a[]; };
layout(set = 0, binding = 2) readonly buffer P { uint p[]; };
layout(set = 0, binding = 3) writeonly buffer DA { float da[]; };
void main() {
    uint N = p[0];
    uint i = gl_GlobalInvocationID.x;
    if (i >= N) { return; }
    da[i] = dc[i] * (1.0 - a[i] * a[i]);
}
